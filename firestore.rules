rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function ownsUser(userId) {
      return request.auth != null
        && get(/databases/$(database)/documents/user/$(userId)).data.uid == request.auth.uid;
    }

    function hasNoPreRetreatPayments() {
      return request.resource.data.get('pre_retreat_payments', []).size() == 0;
    }

    function canSubmitRequest(userId, retreatId) {
      let retreat = get(/databases/$(database)/documents/user/$(userId)/retreat/$(retreatId));
      return retreat.data.user_id == userId
        && retreat.data.accept_requests == true
        && request.resource.data.retreat == retreatId
        && hasNoPreRetreatPayments();
    }

    function canCreateInitialHistoryEntry() {
      return request.auth == null
        && request.resource.data.action == 'new'
        && request.resource.data.message == 'Solicitud creada'
        && request.resource.data.collection_state == 'request'
        && request.resource.data.retreat_id == ''
        && !('receipt_path' in request.resource.data)
        && !('receipt_url' in request.resource.data)
        && !('payment_id' in request.resource.data);
    }

    match /user/{userId} {
      allow read: if true;
      allow create, update, delete: if ownsUser(userId);

      match /retreat/{retreatId} {
        allow read: if true;
        allow create, update, delete: if ownsUser(userId);

        match /request/{requestId} {
          allow get: if true;
          allow list: if ownsUser(userId);
          allow create: if ownsUser(userId) || canSubmitRequest(userId, retreatId);
          allow update, delete: if ownsUser(userId);
        }
      }

      match /requests-archived/{requestId} {
        allow read, write: if ownsUser(userId);
      }

      match /requests-history/{historyId} {
        allow read, update, delete: if ownsUser(userId);
        allow create: if ownsUser(userId) || canCreateInitialHistoryEntry();
      }

      match /push_token/{tokenId} {
        allow read, write: if ownsUser(userId);
      }

      match /files/{fileId} {
        allow read, write: if ownsUser(userId);
      }
    }

    match /retreat_home/{retreatHomeId} {
      allow read: if true;
      allow write: if request.auth != null;
    }

    match /files/{fileId} {
      allow read: if true;
      allow write: if request.auth != null;
    }

    match /city/{cityId} {
      allow read: if true;
      allow write: if request.auth != null;
    }
  }
}
