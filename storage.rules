rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    // Permitir acceso a usuarios autenticados para la carpeta retreat_homes
    match /retreat_homes/{allPaths=**} {
      allow read, write: if request.auth != null;
    }
    
    // Regla general: solo usuarios autenticados pueden acceder
    match /{allPaths=**} {
      allow read, write: if request.auth != null;
    }
  }
} 